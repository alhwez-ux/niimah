# انسخ هذا الملف إلى .env ثم ضع مفاتيح مشروع Firebase.
# فعّل مزوّد Email/Password، ثم أنشئ حساب المالك بالأمر: npm run create-owner

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# يُستخدم مرة واحدة داخل سكربت إنشاء الحساب، ولا يُرسل إلى واجهة التطبيق.
OWNER_EMAIL=
OWNER_PASSWORD=
